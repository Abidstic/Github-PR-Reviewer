# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY_PATH=path/to/private-key.pem
# On Railway, paste the key contents directly instead of a path:
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Protects the POST /admin/setup endpoint. Send it as the X-Admin-Secret header.
# If unset, the endpoint is unprotected (a warning is logged).
ADMIN_SECRET=your_admin_secret_here

# AI/LLM Configuration
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# Webhook Server Configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000

# Data Directory (SQLite DB, JSON profiles, FAISS index all live here)
# On Railway, set this to your persistent volume mount path (e.g. /data)
# so data survives deploys and restarts. Defaults to ./data locally.
DATA_DIR=data

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log